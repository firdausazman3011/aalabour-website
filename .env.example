# Form emails are sent over SMTP by src/app/api/contact/route.ts.
# With Gmail: turn on 2-Step Verification for the sending account, then create an
# App Password at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Inbox that receives form submissions. Defaults to aalabourcambodia@gmail.com.
FORM_TO_EMAIL=

# Public URL of the deployed site, used for canonical and hreflang links.
NEXT_PUBLIC_SITE_URL=https://aalabors.com
